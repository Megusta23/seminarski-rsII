### Health
GET {{baseUrl}}/api/health

### User login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "password": "{{userPassword}}"
}

### Administrator login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

### Own profile overview
GET {{baseUrl}}/api/profile/me/overview
Authorization: Bearer {{userToken}}

### Reference data
GET {{baseUrl}}/api/reference-data/task-categories
Authorization: Bearer {{userToken}}

### Create task
POST {{baseUrl}}/api/tasks
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "title": "Finish Ladder Social milestone",
  "description": "Test the task API from VS Code.",
  "taskCategoryId": "paste-category-guid",
  "recurrenceTypeId": "paste-recurrence-guid",
  "dueAtUtc": null,
  "requiresProofImage": false,
  "shareWithFriends": true
}

### Filter my tasks
GET {{baseUrl}}/api/tasks?search=Ladder&page=1&pageSize=20&sortBy=dueAtUtc&sortDirection=asc
Authorization: Bearer {{userToken}}

### Task details
GET {{baseUrl}}/api/tasks/{{taskId}}
Authorization: Bearer {{userToken}}

### Complete task (REST Client multipart syntax)
POST {{baseUrl}}/api/tasks/{{taskId}}/complete
Authorization: Bearer {{userToken}}
Content-Type: multipart/form-data; boundary=LadderBoundary

--LadderBoundary
Content-Disposition: form-data; name="occurrenceDate"

2026-08-20
--LadderBoundary
Content-Disposition: form-data; name="note"

Completed through requests/application.http
--LadderBoundary--

### Search users
GET {{baseUrl}}/api/friends/search?search=&page=1&pageSize=20
Authorization: Bearer {{userToken}}

### Send friend request
POST {{baseUrl}}/api/friends/requests/{{friendUserId}}
Authorization: Bearer {{userToken}}

### Accept friend request
POST {{baseUrl}}/api/friends/requests/{{friendRequestId}}/accept
Authorization: Bearer {{userToken}}

### Friend recommendations
GET {{baseUrl}}/api/friends/recommendations
Authorization: Bearer {{userToken}}

### Feed
GET {{baseUrl}}/api/feed?page=1&pageSize=20
Authorization: Bearer {{userToken}}

### Mark feed post viewed
POST {{baseUrl}}/api/feed/{{postId}}/view
Authorization: Bearer {{userToken}}

### Daily leaderboard
GET {{baseUrl}}/api/leaderboard/daily
Authorization: Bearer {{userToken}}

### Notifications
GET {{baseUrl}}/api/notifications?isRead=false&page=1&pageSize=20
Authorization: Bearer {{userToken}}

### Mark notification read
POST {{baseUrl}}/api/notifications/{{notificationId}}/read
Authorization: Bearer {{userToken}}

### Start direct conversation
POST {{baseUrl}}/api/conversations/direct/{{friendUserId}}
Authorization: Bearer {{userToken}}

### Register sender public device key
# The Flutter client generates the X25519 key pair. Only this public key is sent.
PUT {{baseUrl}}/api/conversations/device-keys
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "deviceId": "{{senderDeviceId}}",
  "publicKey": "{{senderPublicKeyBase64}}"
}

### Register recipient public device key (run as the friend account)
PUT {{baseUrl}}/api/conversations/device-keys
Authorization: Bearer {{friendToken}}
Content-Type: application/json

{
  "deviceId": "{{recipientDeviceId}}",
  "publicKey": "{{recipientPublicKeyBase64}}"
}

### List conversation public device keys
GET {{baseUrl}}/api/conversations/{{conversationId}}/device-keys?page=1&pageSize=100
Authorization: Bearer {{userToken}}

### Store sender's encrypted conversation-key envelope
# Paste the device-key GUIDs returned by the registration responses above.
# The encryptedConversationKey and nonce are produced locally by Flutter.
PUT {{baseUrl}}/api/conversations/{{conversationId}}/key-envelopes
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "recipientDeviceKeyId": "{{senderDeviceKeyId}}",
  "senderDeviceKeyId": "{{senderDeviceKeyId}}",
  "encryptedConversationKey": "{{senderEnvelopeBase64}}",
  "nonce": "{{senderEnvelopeNonceBase64}}",
  "keyVersion": 1
}

### Store recipient's encrypted conversation-key envelope
PUT {{baseUrl}}/api/conversations/{{conversationId}}/key-envelopes
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "recipientDeviceKeyId": "{{recipientDeviceKeyId}}",
  "senderDeviceKeyId": "{{senderDeviceKeyId}}",
  "encryptedConversationKey": "{{recipientEnvelopeBase64}}",
  "nonce": "{{recipientEnvelopeNonceBase64}}",
  "keyVersion": 1
}

### Send end-to-end encrypted text
# These Base64 fields are ciphertext and nonce generated on the Flutter client.
# No plaintext content field is accepted by the private-message write endpoint.
POST {{baseUrl}}/api/conversations/{{conversationId}}/messages/e2e
Authorization: Bearer {{userToken}}
Content-Type: multipart/form-data; boundary=EncryptedMessageBoundary

--EncryptedMessageBoundary
Content-Disposition: form-data; name="type"

1
--EncryptedMessageBoundary
Content-Disposition: form-data; name="senderDeviceKeyId"

{{senderDeviceKeyId}}
--EncryptedMessageBoundary
Content-Disposition: form-data; name="keyVersion"

1
--EncryptedMessageBoundary
Content-Disposition: form-data; name="encryptedContentBase64"

{{encryptedTextBase64}}
--EncryptedMessageBoundary
Content-Disposition: form-data; name="contentNonceBase64"

{{encryptedTextNonceBase64}}
--EncryptedMessageBoundary--

### Conversation messages
GET {{baseUrl}}/api/conversations/{{conversationId}}/messages?page=1&pageSize=20
Authorization: Bearer {{userToken}}

### Admin dashboard
GET {{baseUrl}}/api/admin/dashboard
Authorization: Bearer {{adminToken}}

### Admin countries
GET {{baseUrl}}/api/admin/reference-data/countries?page=1&pageSize=20
Authorization: Bearer {{adminToken}}

### Create country
POST {{baseUrl}}/api/admin/reference-data/countries
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Test Country",
  "isoCode": "TC",
  "sortOrder": 100
}

### Admin users
GET {{baseUrl}}/api/admin/users?page=1&pageSize=20
Authorization: Bearer {{adminToken}}

### User report
GET {{baseUrl}}/api/admin/reports/users/{{userId}}
Authorization: Bearer {{adminToken}}

### Activity report
GET {{baseUrl}}/api/admin/reports/activity?fromDate=2026-08-01&toDate=2026-08-31
Authorization: Bearer {{adminToken}}
