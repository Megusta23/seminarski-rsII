@baseUrl = http://localhost:5001
@smtp4devUrl = http://localhost:5002
@email = recovery.user@example.com
@initialPassword = Recovery_Initial_220087!
@resetPassword = Recovery_Reset_220087!
@finalPassword = Recovery_Final_220087!
@resetCode = 000000
@accessToken = paste-access-token-here
@refreshToken = paste-refresh-token-here
@cityId = paste-city-id-here

### Register a disposable test user - expect 201
# @name registerRecoveryUser
POST {{baseUrl}}/api/auth/register
Content-Type: application/json
Accept: application/json

{
  "email": "{{email}}",
  "password": "{{initialPassword}}",
  "confirmPassword": "{{initialPassword}}",
  "firstName": "Recovery",
  "lastName": "Tester"
}

### Request a reset code - expect 202 and a generic response
POST {{baseUrl}}/api/auth/forgot-password
Content-Type: application/json
Accept: application/json

{
  "email": "{{email}}"
}

### Open the smtp4dev UI and copy the six-digit code
# GET {{smtp4devUrl}}

### List smtp4dev messages through its local API
GET {{smtp4devUrl}}/api/messages?searchTerms={{email}}&pageSize=100
Accept: application/json

### Reset password - update resetCode first; expect 204
POST {{baseUrl}}/api/auth/reset-password
Content-Type: application/json
Accept: application/json

{
  "email": "{{email}}",
  "code": "{{resetCode}}",
  "newPassword": "{{resetPassword}}",
  "confirmPassword": "{{resetPassword}}"
}

### Login with reset password - expect 200; copy access/refresh tokens
POST {{baseUrl}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "{{email}}",
  "password": "{{resetPassword}}"
}

### Change password while authenticated - expect 204
POST {{baseUrl}}/api/profile/change-password
Authorization: Bearer {{accessToken}}
Content-Type: application/json
Accept: application/json

{
  "currentPassword": "{{resetPassword}}",
  "newPassword": "{{finalPassword}}",
  "confirmPassword": "{{finalPassword}}"
}

### The old access token should now be invalid - expect 401
GET {{baseUrl}}/api/profile/me
Authorization: Bearer {{accessToken}}
Accept: application/json

### Login using the final password - expect 200
# Copy the new accessToken and refreshToken into the variables above before continuing.
POST {{baseUrl}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "{{email}}",
  "password": "{{finalPassword}}"
}

### Load countries - authenticated, expect 200
GET {{baseUrl}}/api/reference-data/countries
Authorization: Bearer {{accessToken}}
Accept: application/json

### Load cities - authenticated, expect 200
GET {{baseUrl}}/api/reference-data/cities
Authorization: Bearer {{accessToken}}
Accept: application/json

### Load task categories - authenticated, expect 200
GET {{baseUrl}}/api/reference-data/task-categories
Authorization: Bearer {{accessToken}}
Accept: application/json

### Load recurrence types - authenticated, expect 200
GET {{baseUrl}}/api/reference-data/recurrence-types
Authorization: Bearer {{accessToken}}
Accept: application/json

### Update current profile - replace cityId; expect 200
PUT {{baseUrl}}/api/profile/me
Authorization: Bearer {{accessToken}}
Content-Type: application/json
Accept: application/json

{
  "firstName": "Updated",
  "lastName": "Profile",
  "bio": "Profile updated through the REST Client collection.",
  "cityId": "{{cityId}}",
  "dateOfBirth": "2000-01-15"
}

### Logout the final session - expect 204
POST {{baseUrl}}/api/auth/logout
Authorization: Bearer {{accessToken}}
Content-Type: application/json
Accept: application/json

{
  "refreshToken": "{{refreshToken}}"
}
