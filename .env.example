# Copy this file to .env. Never commit the real .env file.

COMPOSE_PROJECT_NAME=ladder-social

# SQL Server
SQL_SA_PASSWORD=ChangeThis_StrongPassword_220087!
SQL_HOST_PORT=14333
DATABASE_NAME=220087
DATABASE_BOOTSTRAP_MODE=migrate

# API
API_HOST_PORT=5001
JWT_KEY=replace-with-at-least-64-random-characters-before-real-use-220087
JWT_ISSUER=LadderSocial.Api
JWT_AUDIENCE=LadderSocial.Clients
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=14
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Password recovery. Generate independent random values; do not reuse JWT_KEY.
PASSWORD_RESET_HASH_KEY=replace-with-a-different-random-value-of-at-least-64-characters
PASSWORD_RESET_EVENT_KEY=replace-with-another-random-value-of-at-least-64-characters
PASSWORD_RESET_CODE_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_MIN_REQUEST_INTERVAL_SECONDS=60

# Seed users
SEED_ADMIN_EMAIL=admin@laddersocial.local
SEED_ADMIN_PASSWORD=Admin_Test_220087!
SEED_MOBILE_EMAIL=mobile@laddersocial.local
SEED_MOBILE_PASSWORD=Mobile_Test_220087!

# RabbitMQ
RABBITMQ_USERNAME=ladder
RABBITMQ_PASSWORD=ladder_test_220087
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE_NAME=ladder-social.events
RABBITMQ_PASSWORD_RESET_QUEUE=ladder-social.password-reset-email
RABBITMQ_PASSWORD_RESET_ROUTING_KEY=auth.password-reset.requested
RABBITMQ_DEAD_LETTER_EXCHANGE=ladder-social.dead-letter
RABBITMQ_PASSWORD_RESET_DEAD_LETTER_QUEUE=ladder-social.password-reset-email.dead
RABBITMQ_PASSWORD_RESET_DEAD_LETTER_ROUTING_KEY=auth.password-reset.dead

# Local SMTP inbox. The Worker reaches smtp4dev internally on smtp4dev:25.
SMTP4DEV_WEB_HOST_PORT=5002
SMTP_HOST_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=false
SMTP_USE_STARTTLS=false
SMTP_FROM_ADDRESS=no-reply@laddersocial.local
SMTP_FROM_NAME=Ladder Social
